{
  "redirects": [
    {
      "source": "/sitemap-products.xml",
      "destination": "/api/sitemap-products",
      "permanent": false
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/product",
      "destination": "/products",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms https://cdn.jsdelivr.net; connect-src 'self' https://sanju-sk-live.onrender.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://www.instagram.com; frame-ancestors 'none';"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/products/:id",
      "destination": "/api/product-seo?id=:id"
    },
    {
      "source": "/product-view/:id",
      "destination": "/"
    },
    {
      "source": "/wedding-card-printing-gondia",
      "destination": "/wedding-card-printing-gondia/index.html"
    },
    {
      "source": "/wedding-card-printing-gondia/",
      "destination": "/wedding-card-printing-gondia/index.html"
    },
    {
      "source": "/digital-wedding-invitations",
      "destination": "/digital-wedding-invitations/index.html"
    },
    {
      "source": "/digital-wedding-invitations/",
      "destination": "/digital-wedding-invitations/index.html"
    },
    {
      "source": "/corporate-gifting-gondia",
      "destination": "/corporate-gifting-gondia/index.html"
    },
    {
      "source": "/corporate-gifting-gondia/",
      "destination": "/corporate-gifting-gondia/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
