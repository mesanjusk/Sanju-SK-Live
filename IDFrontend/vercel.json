{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sanjusk.in"
        }
      ],
      "destination": "https://www.sanjusk.in/:path*",
      "statusCode": 301
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/product",
      "destination": "/products",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com https://www.googletagmanager.com https://www.clarity.ms https://cdn.jsdelivr.net; connect-src 'self' https://*.razorpay.com https://sanju-sk-live.onrender.com; frame-src https://*.razorpay.com https://www.youtube.com https://www.youtube-nocookie.com https://www.instagram.com; frame-ancestors 'none';"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/feeds/google-merchant.xml",
      "destination": "https://sanju-sk-live.onrender.com/feeds/google-merchant.xml"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/sitemap-products.xml",
      "destination": "/api/sitemap-products"
    },
    {
      "source": "/products/:id",
      "destination": "/api/product-seo?id=:id"
    },
    {
      "source": "/categories/:slug",
      "destination": "/api/catalog-page?slug=:slug"
    },
    {
      "source": "/categories/:slug/",
      "destination": "/api/catalog-page?slug=:slug"
    },
    {
      "source": "/product-view/:id",
      "destination": "/"
    },
    {
      "source": "/wedding-card-printing-gondia",
      "destination": "/api/catalog-page?service=wedding-card-printing-gondia"
    },
    {
      "source": "/wedding-card-printing-gondia/",
      "destination": "/api/catalog-page?service=wedding-card-printing-gondia"
    },
    {
      "source": "/digital-wedding-invitations",
      "destination": "/api/catalog-page?service=digital-wedding-invitations"
    },
    {
      "source": "/digital-wedding-invitations/",
      "destination": "/api/catalog-page?service=digital-wedding-invitations"
    },
    {
      "source": "/corporate-gifting-gondia",
      "destination": "/api/catalog-page?service=corporate-gifting-gondia"
    },
    {
      "source": "/corporate-gifting-gondia/",
      "destination": "/api/catalog-page?service=corporate-gifting-gondia"
    },
    {
      "source": "/3d-led-sign-boards-gondia",
      "destination": "/api/catalog-page?service=3d-led-sign-boards-gondia"
    },
    {
      "source": "/3d-led-sign-boards-gondia/",
      "destination": "/api/catalog-page?service=3d-led-sign-boards-gondia"
    },
    {
      "source": "/custom-trophies-awards-gondia",
      "destination": "/api/catalog-page?service=custom-trophies-awards-gondia"
    },
    {
      "source": "/custom-trophies-awards-gondia/",
      "destination": "/api/catalog-page?service=custom-trophies-awards-gondia"
    },
    {
      "source": "/flex-banner-printing-gondia",
      "destination": "/api/catalog-page?service=flex-banner-printing-gondia"
    },
    {
      "source": "/flex-banner-printing-gondia/",
      "destination": "/api/catalog-page?service=flex-banner-printing-gondia"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
