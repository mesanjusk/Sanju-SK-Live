# Configure only in the private Render service environment; never commit actual values.
MONGO_URI=
JWT_SECRET=
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Must be configured by the merchant before UPI can be activated:
# Explicit confirmation of GST treatment and delivery fees.
ORDER_PRICING_CONFIGURED=false
ORDER_PRICE_TAX_MODE=
ORDER_GST_RATE_BPS=
ORDER_DELIVERY_FEE_PAISE=

# Optional server-to-server MISBoth order integration. Must be a real HTTPS
# receiver built/approved by the MIS owner; do not guess an endpoint.
MIS_ORDER_WEBHOOK_URL=
MIS_ORDER_WEBHOOK_SECRET=
